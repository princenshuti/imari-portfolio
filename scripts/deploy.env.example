# Copy this file to the project root as ".env.deploy" and fill in your
# cPanel FTP credentials. .env.deploy is gitignored — never commit it.
#
#   cp scripts/deploy.env.example .env.deploy
#
FTP_HOST=ftp.princenshuti.com
FTP_USER=your-cpanel-ftp-user
FTP_PASSWORD=your-ftp-password

# Optional ---------------------------------------------------------------
# Port (21 = standard FTP/FTPS explicit).
FTP_PORT=21
# FTPS over explicit TLS (recommended). Set false only if your host blocks it.
FTP_SECURE=true
# Document root for the subdomain, relative to the FTP user's home.
#   - If the FTP user is scoped to the subdomain, leave as "/".
#   - If it's the main cPanel account, use the subdomain folder, e.g.
#     "imali.princenshuti.com/" or "public_html/imali/".
FTP_REMOTE_DIR=/
