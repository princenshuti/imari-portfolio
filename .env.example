# Frontend build-time config (baked into the bundle — anon key is public by design).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local dev only. In production the Anthropic key lives in the Supabase
# Edge Function `ai-proxy` (server-side secret) — never ship it to the client.
# VITE_ANTHROPIC_KEY=sk-ant-...
